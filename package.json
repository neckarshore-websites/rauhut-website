{
  "name": "rauhut-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "check:agent-files": "node scripts/check-agent-files.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --grep-invert @external",
    "lighthouse": "node scripts/lighthouse.mjs",
    "lighthouse:quick": "node scripts/lighthouse.mjs --quick",
    "lighthouse:desktop": "node scripts/lighthouse.mjs --quick --profile=desktop",
    "lighthouse:mobile": "node scripts/lighthouse.mjs --quick --profile=mobile-4g",
    "lighthouse:5g": "node scripts/lighthouse.mjs --quick --profile=mobile-5g",
    "test:lighthouse:unit": "node --test scripts/lighthouse-profiles.test.mjs",
    "test:unit": "node --test src/app/actions/inquiry.test.ts scripts/lighthouse-url.test.mjs scripts/public-figures.test.mjs scripts/contact-mail.test.mjs scripts/contact-confirmation.test.mjs scripts/typography-tokens.test.mjs scripts/check-agent-files.test.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.13.5",
    "@types/nodemailer": "8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "10.8.1",
    "eslint-config-next": "16.4.2",
    "lighthouse": "13.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
